# Example environment variables for local development using Docker Compose
# Copy this file to .env and fill in the values.

# GCP Project ID
GCP_PROJECT_ID="your-gcp-project-id"

# GCS Bucket Name (from Terraform output)
GCS_BUCKET_NAME="leaderboard-data-lake-..."

# Kafka Broker connection strings (comma-separated)
KAFKA_BROKERS="kafka-broker-1:9092,kafka-broker-2:9092"

# Kafka Topic
KAFKA_TOPIC="leaderboard_events"
